Options -Indexes -MultiViews
RewriteEngine On

# Real files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Home: / or /{lang}
RewriteRule ^$ index.html [L]
RewriteRule ^(es|en|fr|de)/?$ index.html [L]

# Service pages: /{section} or /{section}/{lang}
RewriteRule ^(electricidad|construccion|pladur|alicatados|fontaneria|piscinas|seguridad|carpinteria|soldadura|manitas)(/(es|en|fr|de))?/?$ $1.html [L]

# Fallback
RewriteRule ^.*$ index.html [L]
